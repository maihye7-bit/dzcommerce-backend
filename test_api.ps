$apiKey = (Select-String -Path ".env" -Pattern "OPENROUTER_API_KEY").Line -replace "OPENROUTER_API_KEY=", ""; $headers = @{ "Authorization" = "Bearer $apiKey"; "Content-Type" = "application/json" }; $body = @{ model = "qwen/qwen-.-b-instruct"; messages = @(@{ role = "user"; content = "?? ?????" }); max_tokens =  } | ConvertTo-Json; try { $r = Invoke-RestMethod -Uri "https://openrouter.ai/api/v/chat/completions" -Method POST -Headers $headers -Body $body; Write-Host "? ???: $($r.choices[].message.content)" -ForegroundColor Green } catch { Write-Host "? ???: $($_.Exception.Message)" -ForegroundColor Red }
